# =====================================================================
# application.properties.example
#
# 사용법:
#   1) 이 파일을 application.properties 로 복사
#        cp application.properties.example application.properties
#   2) spring.datasource.password 에 별도 전달받은 TiDB 비밀번호 입력
#   3) 서버 기동
#
# 주의: 실제 application.properties 는 .gitignore 처리되어 커밋되지 않습니다.
#       비밀번호는 이 example 에 적지 말고, 복사한 application.properties 에만 넣으세요.
# =====================================================================

spring.application.name=k-evolution

# Database (TiDB Cloud Serverless / 공용 DB · MySQL 호환)
# TiDB 는 TLS 필수라 sslMode=REQUIRED (암호화 강제, 인증서 검증은 생략 → CA 파일 불필요).
spring.datasource.url=jdbc:mysql://gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/k-evolution?sslMode=REQUIRED&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=3qt5Sm6zDnthj9u.root
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- 기존 로컬 도커 MySQL (롤백용, 주석 처리) ---
#spring.datasource.url=jdbc:mysql://127.0.0.1:3306/k-evolution?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
#spring.datasource.username=root
#spring.datasource.password=1234

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# JSP
spring.mvc.view.prefix=/WEB-INF/views/
spring.mvc.view.suffix=.jsp

# AES-256 암호화 키 (32바이트를 Base64로 인코딩한 값)
# 개인정보(전화/주소/CI 등) 복호화 키이므로 비밀번호와 동급의 비밀입니다 → 별도 전달.
# 공용 DB 를 함께 쓰는 모든 환경은 반드시 "같은" 키를 써야 합니다.
# (키가 다르면 DB 에 저장된 암호화 개인정보를 복호화할 수 없습니다.)
aes.secret-key=

# Hidden Method Filter
spring.mvc.hiddenmethod.filter.enabled=true

# Toss Payments (실제 키는 각자 발급받아 application.properties 에 입력)
toss.secret-key=test_sk_여기에입력
toss.client-key=test_ck_여기에입력

# KG이니시스 웹표준결제(INIStdPay)
# 아래는 이니시스 공용 테스트 MID/사인키 (실결제·정산 없음). 운영 시 발급받은 값으로 교체.
# signKey 는 가맹점관리자 ▶ 상점정보 ▶ 계약정보 ▶ KEY 정보 ▶ 웹결제 Sign Key 에서 확인.
inicis.mid=INIpayTest
inicis.sign-key=SU5JTElURV9UUklQTEVERVNfS0VZU1RS

# Supabase (배너 등 이미지 저장용 Storage)
# SECRET_KEY 는 service_role 급 비밀이므로 example 에 적지 말고 application.properties 에만 입력.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_여기에입력
SUPABASE_SECRET_KEY=sb_secret_여기에입력
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# 이미지 업로드 대상 버킷 — Supabase 대시보드 Storage 에서 만든 버킷 이름 그대로(대소문자 구분).
# 반드시 Public 버킷이어야 업로드한 이미지가 화면에 표시됩니다.
supabase.storage.bucket=YOUR_BUCKET_NAME

# 파일 업로드 크기 제한 (배너/상품 이미지)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
# 멀티파트 파트 개수 제한 (Tomcat 기본 10). 상품 옵션 등 폼 필드가 많아 상향
server.tomcat.max-part-count=1000
